# ════════════════════════════════════════════════
#  Smart Home Backend — Environment Variables
#  Copiază acest fișier în .env și completează valorile reale
# ════════════════════════════════════════════════

# === DATABASE ===
DATABASE_URL=sqlite:///./smart_home.db

# === JWT Authentication ===
# Generează cu: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=PUNE_CHEIA_NOUA_AICI

# === MQTT Broker ===
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# === SMTP Email (Gmail cu App Password) ===
# Generează App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
